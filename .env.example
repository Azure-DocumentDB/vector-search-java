# Copy only if .env does not exist. This Java program does NOT autoload .env.
# Export variables using your shell or a trusted environment-file loader.
DOCUMENTDB_HOST=<approved-cluster>.global.mongocluster.cosmos.azure.com
DOCUMENTDB_DATABASE=<approved-disposable-database>
DOCUMENTDB_COLLECTION_PREFIX=<unique-owner-prefix>
ALLOW_DATABASE_WRITES=false
DOCUMENTDB_AUTH=native
DOCUMENTDB_USERNAME=<native-username>
DOCUMENTDB_PASSWORD=<native-password>
# For oidc: DOCUMENTDB_AUTH=oidc; REMOVE username/password variables entirely.
# Authenticate with Azure CLI or the supported DefaultAzureCredential chain.
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
EMBEDDED_FIELD=DescriptionVector
EMBEDDING_DIMENSIONS=1536
TOP_K=5
OPERATION_TIMEOUT_SECONDS=20
SEARCH_ATTEMPTS=4
SEARCH_RETRY_DELAY_MS=1000
VERIFY_FIXTURE_RANKING=true
# Explicit opt-in additionally required by mvn verify -Pintegration:
RUN_AZURE_INTEGRATION=false
